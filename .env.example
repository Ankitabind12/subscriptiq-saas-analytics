# ==============================================================================
# SubscriptIQ Environment Configuration Template
# Copy this file to .env and customize with your local credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database Target: 'sqlite' (zero-config local) or 'postgres' (enterprise DWH)
DB_ENGINE=sqlite

# PostgreSQL Connection Settings (when DB_ENGINE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=subscriptiq_dwh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SCHEMA=public

# SQLite Configuration (when DB_ENGINE=sqlite)
SQLITE_DB_PATH=data/subscriptiq.db

# Pipeline Execution Settings
LOG_LEVEL=INFO
BATCH_SIZE=1000
SYNTHETIC_RANDOM_SEED=42

# Export & BI Settings
EXPORT_GOLD_CSV=true
EXPORT_PATH=data/gold_exports
